MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=portfolio_analyzer
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TRUSTED_CONNECTION=yes
# If not using Windows auth, set these instead and MSSQL_TRUSTED_CONNECTION=no
MSSQL_USERNAME=
MSSQL_PASSWORD=

# Optional — overrides all MSSQL_* settings above with a full SQLAlchemy URL instead.
# Leave blank for local dev (uses MSSQL_* above). Set this for a deployment whose
# database isn't a locally-reachable SQL Server, e.g. Render's managed Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@host/dbname
DATABASE_URL=

# Generate a real secret for any non-local use, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins for CORS. Defaults to the local
# Vite dev server if unset — override for any other deployment, e.g.:
# CORS_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ORIGINS=http://localhost:5173

# Optional — leave blank to run with no error tracking (the SDK no-ops on an empty
# DSN). Get a free one at https://sentry.io (New Project → Python → FastAPI).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional — leave blank to run as a single process with no cross-process WebSocket
# fanout (fine for local dev / a single-worker deploy). Only needed once this app runs
# behind more than one uvicorn worker. Requires a real Redis server — e.g. run one via
# Docker: docker run -d -p 6379:6379 redis:7-alpine
# Also shares market_data_provider's Yahoo/CoinGecko response caches across workers —
# see services/redis_client.py's cache_get_json/cache_set_json.
REDIS_URL=

# Optional — leave SMTP_HOST blank to run with no email notifications (a triggered
# alert still lands on the in-app "alerts" WebSocket channel either way). Any real
# SMTP provider works — e.g. Gmail with an app password, SendGrid, Mailgun, AWS SES's
# SMTP interface.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=alerts@portfolio-analyzer.local

# Optional — leave blank to run with no browser push notifications (a triggered alert
# still lands in-app/email either way). Generate a keypair with
# `python -m scripts.generate_vapid_keys` (from backend/); copy VAPID_PUBLIC_KEY into
# frontend/.env.local as VITE_VAPID_PUBLIC_KEY too. Never share VAPID_PRIVATE_KEY with
# the frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@portfolio-analyzer.local
