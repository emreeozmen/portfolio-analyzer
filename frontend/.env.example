# Copy to .env.local for local overrides — Vite only reads VITE_-prefixed vars.
VITE_API_BASE_URL=http://localhost:8000

# Optional — leave blank to run with no error tracking (the SDK no-ops on an empty
# DSN). Get a free one at https://sentry.io (New Project → React).
VITE_SENTRY_DSN=

# Optional — leave blank to hide the push-notification opt-in (see backend's
# VAPID_PUBLIC_KEY, generated via `python -m scripts.generate_vapid_keys`). Must match
# the backend's key exactly — this is the public half only, safe to expose.
VITE_VAPID_PUBLIC_KEY=
